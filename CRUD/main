package kz.uib.kitaphana;

import kz.uib.kitaphana.config.DBConnection;
import kz.uib.kitaphana.ui.ConsoleMenu;

import java.sql.Connection;
import java.sql.SQLException;

public class Main {
    public static void main(String[] args) {
        System.out.println("«Кітапхана» — Java + PostgreSQL CRUD жобасы");
        try (Connection ignored = DBConnection.getConnection()) {
            System.out.println("PostgreSQL деректер қорына қосылым сәтті орнатылды.");
        } catch (SQLException e) {
            System.out.println("PostgreSQL-ға қосылу мүмкін болмады: " + e.getMessage());
            System.out.println("PostgreSQL іске қосылғанын, library_db құрылғанын және DBConnection параметрлерін тексеріңіз.");
            return;
        }
        new ConsoleMenu().start();
    }
}
